{
  "name": "meditation-copilot-api",
  "version": "1.0.0",
  "description": "Meditation Copilot events API (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply meditation-copilot --local",
    "db:remote": "wrangler d1 migrations apply meditation-copilot --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.159.0"
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261109.1": true
  }
}
